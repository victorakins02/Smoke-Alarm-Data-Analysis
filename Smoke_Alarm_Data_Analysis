    {
      "cell_type": "code",
      "source": [
        "# 1. Define compliance status groups\n",
        "def compliance_status(alarm_status):\n",
        "    # Compliant: 2 or more alarms\n",
        "    if '2 working smoke alarms' in alarm_status or '3 working smoke alarms' in alarm_status or '4 or more working smoke alarms' in alarm_status:\n",
        "        return 'Compliant (2+ Alarms)'\n",
        "    # Low Compliance/Non-Compliant: 0 or 1 alarm\n",
        "    elif 'No working smoke alarm' in alarm_status or '1 working smoke alarm' in alarm_status or 'No smoke alarm' in alarm_status:\n",
        "        return 'Low Compliance (0-1 Alarms)'\n",
        "    else:\n",
        "        return 'Other/Not Stated'\n",
        "\n"
      ],
      "metadata": {
        "id": "JeKl1XeXSxGS"
      },
      "execution_count": 18,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df_clean_prepared['Compliance_Group'] = df_clean_prepared['Alarm_Status'].apply(compliance_status)\n",
        "\n",
        "# 2. Calculate compliance rate by housing age\n",
        "compliance_by_age = df_clean_prepared.groupby(['Year_Built', 'Compliance_Group'])['Households'].sum().unstack(fill_value=0)\n",
        "\n",
        "# Calculate the percentage of Compliant households for each age group\n",
        "compliant_column = 'Compliant (2+ Alarms)'\n",
        "if compliant_column not in compliance_by_age.columns:\n",
        "    compliance_by_age[compliant_column] = 0"
      ],
      "metadata": {
        "id": "ZDApi6Mf2Yc1"
      },
      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "compliance_by_age['Total_Households'] = compliance_by_age.sum(axis=1)\n",
        "\n",
        "compliance_by_age['%_Compliant'] = (compliance_by_age[compliant_column] / compliance_by_age['Total_Households'].replace(0, 1)) * 100\n",
        "\n",
        "age_order = [\n",
        "    'Before 1900', '1900 to 1919', '1920 to 1945', '1946 to 1960',\n",
        "    '1961 to 1970', '1971 to 1980', '1981 to 1990', '1991 to 2000',\n",
        "    '2001 to 2005', '2006 to 2010', '2011 to 2015', '2016 to 2020',\n",
        "    '2021 and later'\n",
        "]"
      ],
      "metadata": {
        "id": "Ww0cVPw-2fIr"
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df_plot = compliance_by_age.reindex(age_order, axis=0).dropna(subset=['Total_Households'])"
      ],
      "metadata": {
        "id": "AH0ooCFB2k4W"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Create the Bar Chart\n",
        "plt.figure(figsize=(14, 7))\n",
        "plt.bar(\n",
        "    df_plot.index,\n",
        "    df_plot['%_Compliant'],\n",
        "    color='#3498DB'\n",
        ")\n",
        "plt.title(\n",
        "    \"Percentage of Compliant Households (2+ Smoke Alarms) by House Age\",\n",
        "    fontsize=16,\n",
        "    pad=20\n",
        ")\n",
        "plt.xlabel(\"Housing Construction Period (Year Built)\", fontsize=12)\n",
