        "# Define groups for national market assessment\n",
        "def market_group(alarm_status):\n",
        "    # Potential Market: Homes with 0 or 1 alarm (Need to buy 1 or more)\n",
        "    if 'No working smoke alarm' in alarm_status or '1 working smoke alarm' in alarm_status or 'No smoke alarm' in alarm_status:\n",
        "        return '1. Market Potential (0-1 Alarm)'\n",
        "    # Safety Compliant: Homes with 2 or more alarms\n",
        "    elif '2 working smoke alarms' in alarm_status or '3 working smoke alarms' in alarm_status or '4 or more working smoke alarms' in alarm_status:\n",
        "        return '2. Compliant (2+ Alarms)'\n",
        "    else:\n",
        "        # Unknown status\n",
        "        return '3. Other/Not Stated'"
      ],
      "metadata": {
